{
  "name": "ebook-library",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build": "ionic build",
    "sync": "ionic cap sync android",
    "open": "npm run build && npm run sync && ionic cap open android",
    "run": "ionic cap run android -l --host=0.0.0.0 #--external",
    "all": "npm run build && npm run sync && npm run run",
    "build:ci": "ng build --configuration production,ci",
    "test:ci": "ng test --configuration ci",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
